<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Owasp.Untrust.BuildGates</PackageId>
    <Description>OWASP Untrust build-time guardrails for C#.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.5.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <Compile Remove="RequiredConfig\RequestLimits.cs" />
    <None Include="RequiredConfig\RequestLimits.cs" Pack="true" PackagePath="contentFiles/any/any/RequiredConfig/" />
    <Compile Remove="RequiredConfig\AntiforgeryToken.cs" />
    <None Include="RequiredConfig\AntiforgeryToken.cs" Pack="true" PackagePath="contentFiles/any/any/RequiredConfig/" />
  </ItemGroup>
</Project>
